{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:xandymelo/clean-your-tv-lg-retro-theme:retro",
  "title": "Retro",
  "description": "A neon pixel-inspired theme with square cards, hard shadows and a night-blue grid.",
  "author": {
    "name": "xandymelo",
    "url": "https://github.com/xandymelo"
  },
  "themeVersion": "1.1.0",
  "layout": {
    "preset": "dock-grid",
    "columns": 6,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "weather": {
      "formats": [
        "text",
        "current",
        "details",
        "forecast"
      ],
      "scale": 1,
      "padding": 26,
      "icons": "monochrome"
    }
  },
  "defaults": {
    "wallpaperAssetId": null,
    "dim": 0.2,
    "accent": "#ffd23f"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
}
